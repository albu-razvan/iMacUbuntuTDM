#!/bin/bash
set -euo pipefail

STATE_FILE="/run/tdm_state"
LOCK_FILE="/run/tdm_action.lock"
TDM_DIR="__TDM_DIR__"
ACTION="${1:-toggle}"

# fallback if placeholder not replaced (e.g., manual copy) - read repo path saved by installer
if [[ "$TDM_DIR" == "__TDM_DIR__" || ! -d "$TDM_DIR" ]]; then
    if [[ -f /etc/tdm/repo_dir ]]; then
        TDM_DIR="$(cat /etc/tdm/repo_dir 2>/dev/null | tr -d '[:space:]')"
    fi
fi

if [[ ! -d "$TDM_DIR" ]]; then
    echo "tdm-toggle: TDM_DIR not found: $TDM_DIR" >&2
    exit 1
fi

read_state() {
    local current=""
    if [[ -f "$STATE_FILE" ]]; then
        current="$(cat "$STATE_FILE" 2>/dev/null | tr -d '[:space:]')"
    fi

    case "$current" in
        off|tty|tdm) printf '%s\n' "$current" ;;
        "") printf 'off\n' ;;
        *) printf 'off\n' ;;
    esac
}

show_message() {
    local message="$1"
    local hold_seconds="${2:-1}"
    local tty=""

    if [[ -r /sys/class/tty/tty0/active ]]; then
        tty="/dev/$(tr -d '[:space:]' < /sys/class/tty/tty0/active 2>/dev/null || true)"
    fi

    if [[ -z "$tty" || ! -e "$tty" ]]; then
        tty="/dev/console"
    fi

    if [[ ! -e "$tty" ]]; then
        return 0
    fi

    {
        printf '\n\033[1;97;44m[TDM] %s\033[0m\n\n' "$message"
    } > "$tty" 2>/dev/null || true

    sleep "$hold_seconds"
}

set_state() {
    printf '%s\n' "$1" > "$STATE_FILE"
}

wake_local_tty() {
    cd "$TDM_DIR"
    ./tdm_unblank.sh
}

switch_to_tty() {
    cd "$TDM_DIR"
    if ./tdm_off.sh; then
        set_state "tty"
        echo "State: tty"
        show_message "TTY Visible" 1.2
    else
        echo "tdm_off.sh failed, keeping state tdm"
        exit 1
    fi
}

switch_to_tdm() {
    # We can only render this on the local console before the panel is handed off.
    show_message "TDM Active" 1.2

    cd "$TDM_DIR"
    if ./tdm_on.sh; then
        set_state "tdm"
        echo "State: tdm"
    else
        echo "tdm_on.sh failed, keeping state tty"
        exit 1
    fi
}

switch_to_off() {
    local current="$1"
    cd "$TDM_DIR"

    if [[ "$current" == "tdm" ]]; then
        if ! ./tdm_off.sh; then
            echo "tdm_off.sh failed, keeping state $current"
            exit 1
        fi
    fi

    show_message "Turning OFF screen" 1.2

    if ./tdm_blank.sh; then
        set_state "off"
        echo "State: off (blank)"
    else
        echo "tdm_blank.sh failed"
        exit 1
    fi
}

exec 8>"$LOCK_FILE"
flock -x 8

CURRENT="$(read_state)"

case "$ACTION" in
    toggle)
        case "$CURRENT" in
            off)
                echo "Current: off -> Next: tty"
                echo "Running TTY restore..."
                wake_local_tty
                set_state "tty"
                echo "State: tty (unblanked)"
                show_message "TTY Visible" 1.2
                ;;
            tty)
                echo "Current: tty -> Next: tdm"
                echo "Running tdm_on.sh..."
                switch_to_tdm
                ;;
            tdm)
                echo "Current: tdm -> Next: tty"
                echo "Running tdm_off.sh..."
                switch_to_tty
                ;;
        esac
        ;;
    off)
        echo "Current: $CURRENT -> Next: off"
        echo "Running screen off..."
        switch_to_off "$CURRENT"
        ;;
    *)
        echo "Usage: $0 [toggle|off]" >&2
        exit 1
        ;;
esac
